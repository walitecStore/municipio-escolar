# Server-only. Copy to .env.local (ignored); never put values in chat or Git.
# Integration is inactive until explicitly enabled; no connection during builds.
SUPABASE_INTEGRATION_ENABLED=false
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Canonical origin of this Next.js app. HTTPS required outside loopback development.
APP_ORIGIN=http://localhost:3000
# Enable RPC voting ONLY in an approved isolated test project after the security checks.
ELECTORAL_RPC_VOTING_ENABLED=false
# Official mode additionally requires DB purpose=official AND security_approved=true.
# Leave false. This task does not authorize an official election.
ELECTORAL_OFFICIAL_VOTING_ENABLED=false
# Optional; local-test permits ONLY loopback HTTP Supabase test fixtures. Never production.
ELECTORAL_DEPLOYMENT_STAGE=development
